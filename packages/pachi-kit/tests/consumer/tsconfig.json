{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // skipLibCheck true: with false, errors from third-party libraries surface (vue-router, alova, @quasar/app-vite)
    // and TS2344 on `GlobalComponents` in PachiEditDialog.vue.d.ts (vite-plugin-dts output, not fixable from the source).
    // The kit's d.ts files are still verified by usage (event/props types).
    "skipLibCheck": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "types": []
  },
  "include": ["./**/*.ts", "./**/*.vue"],
  "exclude": []
}
