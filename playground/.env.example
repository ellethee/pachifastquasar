# Playground variables (copy to src/.env, not versioned). See the package README, Configuration section.
# Auth (enabled by default)
QCLI_AUTH_ENABLED=true
# QCLI_AUTH_STORAGE=session
# QCLI_AUTH_MENU_PROFILE=true
# QCLI_AUTH_MENU_SETTINGS=true
# QCLI_AUTH_MENU_HOME=true
# App
QCLI_APP_TITLE=Pachi Fast Quasar
# QCLI_APP_DESCRIPTION=Quasar Vue boilerplate
# QCLI_APP_SHOW_LOGO=true
# QCLI_APP_LOGO_SIZE=36px
# QCLI_APP_LOGO_OVERLAP=false
# QCLI_APP_LOCALE=it
# QCLI_APP_AUTO_DASHBOARD=true
# QCLI_APP_SHOW_LOCALE_SWITCHER=true
# QCLI_APP_HIDE_HUB_HEADER=false
# QCLI_APP_DASHBOARD_MAX_WIDTH=1080px
# QCLI_APP_DASHBOARD_COLUMNS=3
# QCLI_APP_TITLE_ANIMATION=rubber-band
# QCLI_APP_GRAVATAR=false
# QCLI_APP_HOVER_EFFECTS=true
# HTTP: false if the backend has PACHIFAST_ENVELOPE_ENABLED=false (responses without success/message/data envelope)
# QCLI_HTTP_ENVELOPE=true
# Development proxy to the backend (read by quasar.config.ts)
QCLI_PROXY_TARGET=http://localhost:8000
