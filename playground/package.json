{
  "name": "pachifastquasar-playground",
  "version": "0.0.0",
  "description": "Quasar app for development and testing of @ilpachi/pachifastquasar (not published)",
  "productName": "Pachi Fast Quasar Playground",
  "author": "ilPachi",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @ilpachi/pachifastquasar build:node && quasar dev",
    "build": "quasar build",
    "typecheck": "pnpm --filter @ilpachi/pachifastquasar build:node && quasar prepare && vue-tsc --noEmit",
    "build:dist": "pnpm --filter @ilpachi/pachifastquasar build && PACHI_PLAYGROUND_DIST=true quasar build"
  },
  "dependencies": {
    "@ilpachi/use-alova": "^2.1.1",
    "@ilpachi/pachi-i18n": "workspace:*",
    "@ilpachi/pachi-kit": "workspace:*",
    "@ilpachi/pachifastquasar": "workspace:*",
    "@quasar/extras": "^2.0.1",
    "alova": "^3.3.0",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "quasar": "^2.35.0",
    "vue": "^3.5.35",
    "vue-i18n": "^11.4.14",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@quasar/app-vite": "^3.10.2",
    "@quasar/vite-plugin": "^2.0.2",
    "@types/node": "^22.0.0",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vue-tsc": "^3.3.13",
    "@ilpachi/fastquasar-settings": "workspace:*",
    "@ilpachi/fastquasar-profile": "workspace:*",
    "@ilpachi/fastquasar-admin": "workspace:*",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  }
}
